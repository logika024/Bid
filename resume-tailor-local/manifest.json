{
  "manifest_version": 3,
  "name": "Resume Tailor Local — Open-Model ATS Resume Generator",
  "version": "1.0.0",
  "description": "Generate an ATS-optimized resume PDF using a LOCAL open-source LLM (Ollama, LM Studio, llama.cpp, vLLM). No GPT, no API key, no cloud calls.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "https://localhost/*",
    "https://localhost:*/*",
    "https://127.0.0.1/*",
    "https://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Tailor Local",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
