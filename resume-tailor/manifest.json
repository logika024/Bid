{
  "manifest_version": 3,
  "name": "Resume Tailor — ATS Job Resume Generator",
  "version": "1.0.0",
  "description": "Generate an ATS-optimized resume PDF from your profile and a pasted job description, saved straight to your chosen folder.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Tailor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
